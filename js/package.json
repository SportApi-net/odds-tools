{
  "name": "odds-tools",
  "version": "0.1.1",
  "description": "Dependency-free betting odds math: format conversion, margin and no-vig fair odds, accumulators, system bets, Kelly staking, EV and arbitrage.",
  "keywords": [
    "odds",
    "betting",
    "sports-betting",
    "decimal-odds",
    "american-odds",
    "fractional-odds",
    "overround",
    "vig",
    "no-vig",
    "devig",
    "kelly-criterion",
    "arbitrage",
    "surebet",
    "parlay",
    "accumulator"
  ],
  "homepage": "https://sportapi.net",
  "bugs": {
    "url": "https://github.com/SportApi-net/odds-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SportApi-net/odds-tools.git",
    "directory": "js"
  },
  "license": "MIT",
  "author": "SportAPI (https://sportapi.net)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/vectors.test.mjs test/api.test.mjs test/cjs.test.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
